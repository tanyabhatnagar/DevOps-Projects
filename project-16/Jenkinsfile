pipeline {
    agent {
        docker {
            image 'tanya119/maven-docker:latest'
            args '-v /var/run/docker.sock:/var/run/docker.sock -v maven-repo:/home/jenkins/.m2 --user 1000'
        }
    }

    environment {
        DOCKER_IMAGE = "tanya119/project16-app:latest"
    }

    stages {
        stage('Validate Workspace') {
            steps {
                sh '''
                echo "=== WORKSPACE CONTENTS ==="
                pwd
                ls -R
                echo "========================="
                '''
            }
        }

        stage('Build JAR') {
            steps {
                dir('project-16') {
                    sh 'mvn clean package -DskipTests'

                    // No need to copy jar anywhere, keep it inside project-16/target
                    sh '''
                    JAR_PATH="$(pwd)/target/project-16-1.0-SNAPSHOT.jar"
                    if [ ! -f "$JAR_PATH" ]; then
                        echo "❌ CRITICAL: JAR NOT FOUND AT $JAR_PATH"
                        exit 1
                    fi
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('project-16') {
                    sh '''
                    docker build --no-cache --progress=plain \
                        -t "$DOCKER_IMAGE" \
                        .
                    docker inspect "$DOCKER_IMAGE" >/dev/null || {
                        echo "❌ IMAGE VERIFICATION FAILED"
                        exit 1
                    }
                    '''
                }
            }
        }

        stage('Push Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: '51611545-1f09-453a-a2a6-e0120a9347f2',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                    echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                    docker push "$DOCKER_IMAGE"
                    docker logout
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts 'project-16/target/*.jar'
            cleanWs()
        }
    }
}
