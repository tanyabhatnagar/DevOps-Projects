pipeline {
    agent {
        docker {
            image 'tanya119/maven-docker:latest'
            args '-v /var/run/docker.sock:/var/run/docker.sock -v maven-repo:/home/jenkins/.m2 --user 1000'
        }
    }

    environment {
        DOCKER_IMAGE = "tanya119/project16-app:latest"
        DOCKER_HUB_CREDENTIALS = credentials('51611545-1f09-453a-a2a6-e0120a9347f2')
    }

    stages {
        stage('Verify Environment') {
            steps {
                sh '''
                echo "=== ENVIRONMENT ==="
                pwd
                ls -la
                java -version
                mvn --version
                docker --version
                echo "=================="
                '''
            }
        }

        stage('Build JAR') {
            steps {
                sh 'mvn clean package -DskipTests'
                sh 'ls -la target/project-16-*.jar'  // Explicit JAR verification
            }
        }

        stage('Prepare Docker Build') {
            steps {
                sh '''
                # Get exact JAR path
                JAR_PATH=$(ls target/project-16-*.jar)
                echo "JAR located at: ${JAR_PATH}"
                
                # Copy to standardized name
                cp "${JAR_PATH}" ./application.jar
                ls -la application.jar  // Verify copy
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                docker build --no-cache --progress=plain -t ${DOCKER_IMAGE} .
                docker inspect ${DOCKER_IMAGE} | grep -i entrypoint  // Verify image
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: '51611545-1f09-453a-a2a6-e0120a9347f2',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                    echo "${DOCKER_PASS}" | docker login -u "${DOCKER_USER}" --password-stdin
                    docker push ${DOCKER_IMAGE}
                    docker logout
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'rm -f ./application.jar'  // Final cleanup
            cleanWs()
        }
    }
}
