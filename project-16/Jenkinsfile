pipeline {
    agent any

    tools {
        jdk 'jdk17'           // Ensure this name matches what's in Jenkins > Global Tool Configuration
        maven 'Maven'         // Should match the configured Maven name in Jenkins
    }

    environment {
        IMAGE_NAME = 'tanya119/project16-app'
        IMAGE_TAG = 'latest'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('Build JAR') {
            steps {
                echo 'Building project with Maven...'
                dir('project-16') {
                    sh 'mvn clean install -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building Docker image ${IMAGE_NAME}:${IMAGE_TAG}..."
                script {
                    dockerImage = docker.build("${IMAGE_NAME}:${IMAGE_TAG}", 'project-16/')
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                echo "Pushing Docker image to Docker Hub..."
                script {
                    withDockerRegistry([credentialsId: '51611545-1f09-453a-a2a6-e0120a9347f2', url: '']) {
                        dockerImage.push()
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed.'
        }
    }
}




