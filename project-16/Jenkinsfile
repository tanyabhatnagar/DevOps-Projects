pipeline {
    agent {
        docker {
            image 'tanya119/maven-docker:latest'  // Your verified custom image
            args '-v /var/run/docker.sock:/var/run/docker.sock -v maven-repo:/home/jenkins/.m2 --user 1000' 
        }
    }
    
    environment {
        DOCKER_IMAGE = "tanya119/project16-app:latest"
        DOCKER_HUB_CREDENTIALS = credentials('51611545-1f09-453a-a2a6-e0120a9347f2')
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }
        
        stage('Build JAR') {
            steps {
                echo 'Building project with Maven...'
                dir('project-16') {
                    sh 'mvn clean package -DskipTests'  // Changed install->package for Spring Boot
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                echo "Building Docker image ${DOCKER_IMAGE}..."
                dir('project-16') {
                    sh "docker build -t ${DOCKER_IMAGE} ."  // Build from project dir
                }
            }
        }
        
        stage('Push Docker Image') {
            steps {
                echo "Pushing Docker image to Docker Hub..."
                withCredentials([usernamePassword(
                    credentialsId: '51611545-1f09-453a-a2a6-e0120a9347f2',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin"
                    sh "docker push ${DOCKER_IMAGE}"
                    sh 'docker logout'
                }
            }
        }
    }
    
    post {
        failure {
            echo 'Pipeline failed. Check console output for details.'
            cleanWs()
        }
        success {
            echo 'Pipeline completed successfully! Artifacts built and pushed.'
            archiveArtifacts 'project-16/target/*.jar'
        }
    }
}
