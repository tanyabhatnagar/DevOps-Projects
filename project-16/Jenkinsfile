pipeline {
    agent any

    tools {
        maven 'Maven'  // This should match the Maven version you installed in Jenkins
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                script {
                    dir('project-16') {  // Make sure we're in the correct directory
                        sh 'mvn clean install'
                    }
                }
            }
        }
    }
}
