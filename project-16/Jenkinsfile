pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk 'JDK 21'
    }

    environment {
        DOCKERHUB_CREDENTIALS = credentials('docker-hub')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'project-16', url: 'https://github.com/tanyabhatnagar/DevOps-Projects.git'
            }
        }

        stage('Build JAR') {
            steps {
                dir('project-16') {
                    sh 'mvn clean install'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('project-16') {
                    sh 'docker build -t tanyabhatnagar/project-16-app:latest .'
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                withDockerRegistry([credentialsId: 'docker-hub', url: '']) {
                    dir('project-16') {
                        sh 'docker push tanyabhatnagar/project-16-app:latest'
                    }
                }
            }
        }
    }
}


