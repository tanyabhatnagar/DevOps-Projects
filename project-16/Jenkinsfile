pipeline {
    agent any

    tools {
        maven 'Maven'  // This should match the Maven version in Jenkins
    }

    environment {
        IMAGE_NAME = "tanya119/project16-app"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build JAR') {
            steps {
                dir('project-16') {
                    sh 'mvn clean install'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('project-16') {
                    sh 'docker build -t $IMAGE_NAME .'
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                dir('project-16') {
                    withDockerRegistry([url: '', credentialsId: 'dockerhub-creds']) {
                        sh 'docker push $IMAGE_NAME'
                    }
                }
            }
        }
    }
}

