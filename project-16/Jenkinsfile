pipeline {
    agent any

    tools {
        maven 'Maven' // Make sure Jenkins → Global Tool Config → Maven is named "Maven"
    }

    environment {
        IMAGE_NAME = "tanya119/project16-app"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build JAR') {
            steps {
                sh 'mvn clean install'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t $IMAGE_NAME .'
            }
        }

        stage('Push Docker Image') {
            steps {
                withDockerRegistry([url: '', credentialsId: 'dockerhub-creds']) {
                    sh 'docker push $IMAGE_NAME'
                }
            }
        }
    }
}

